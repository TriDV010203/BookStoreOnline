@model BookStoreOnline.MVC.Models.LoginViewModel
@{
    Layout = null; // Trang auth dùng layout riêng
    ViewData["Title"] = "Đăng nhập";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookStore Online</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>
<div class="auth-page">
    <div class="auth-container">

        <!-- Logo -->
        <div class="auth-logo">
            <a asp-controller="Home" asp-action="Index">
                <span>📚</span> BookStore
            </a>
        </div>

        <!-- Card -->
        <div class="auth-card">
            <h1 class="auth-title">Đăng nhập</h1>
            <p class="auth-subtitle">Chào mừng trở lại! Vui lòng đăng nhập để tiếp tục.</p>

            <!-- Server Error -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="alert-book alert-danger-book">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span></span>
                </div>
            }

            <!-- Form -->
            <form asp-controller="Account" asp-action="Login" method="post">
                <input type="hidden" asp-for="@ViewData["ReturnUrl"]" />
                @Html.AntiForgeryToken()

                <!-- Email -->
                <div class="form-group-book">
                    <label asp-for="Email" class="form-label-book">
                        <i class="bi bi-envelope me-1"></i> Email
                    </label>
                    <input asp-for="Email"
                           class="form-control-book"
                           placeholder="your@email.com"
                           autocomplete="email"
                           type="email" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <!-- Password -->
                <div class="form-group-book">
                    <label asp-for="Password" class="form-label-book">
                        <i class="bi bi-lock me-1"></i> Mật khẩu
                    </label>
                    <div style="position: relative;">
                        <input asp-for="Password"
                               id="passwordInput"
                               class="form-control-book"
                               placeholder="••••••••"
                               autocomplete="current-password"
                               style="padding-right: 3rem;"
                               type="password" />
                        <button type="button" id="togglePass"
                                style="position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--text-muted); cursor: pointer;">
                            <i class="bi bi-eye" id="eyeIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <!-- Remember me -->
                <div class="form-group-book d-flex align-items-center justify-content-between">
                    <div class="form-check-book">
                        <input asp-for="RememberMe" type="checkbox" id="rememberMe" />
                        <label for="rememberMe">Ghi nhớ đăng nhập</label>
                    </div>
                </div>

                <!-- Submit -->
                <button type="submit" class="btn-auth-submit mt-2">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập
                </button>
            </form>

            <!-- Switch -->
            <div class="auth-switch">
                Chưa có tài khoản?
                <a asp-controller="Account" asp-action="Register">Đăng ký ngay</a>
            </div>

            <div class="auth-switch mt-2">
                <a asp-controller="Home" asp-action="Index" style="color: var(--text-muted); font-size: 0.82rem;">
                    <i class="bi bi-arrow-left me-1"></i>Về trang chủ
                </a>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script>
    // Toggle password visibility
    document.getElementById('togglePass').addEventListener('click', function () {
        var input = document.getElementById('passwordInput');
        var icon = document.getElementById('eyeIcon');
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'bi bi-eye-slash';
        } else {
            input.type = 'password';
            icon.className = 'bi bi-eye';
        }
    });
</script>
</body>
</html>
