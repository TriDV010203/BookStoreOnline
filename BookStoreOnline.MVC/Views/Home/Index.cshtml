@model BookStoreOnline.MVC.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "Trang chủ";
    var isLoggedIn = Context.Session.GetString("UserEmail") != null;
    var userName = Context.Session.GetString("UserFullName") ?? "";
    var searchVal = Model.Search ?? "";
}

<!-- ===== HERO SECTION ===== -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-7">
                <h1 class="hero-title">
                    Khám phá thế giới
                    <span class="accent">tri thức vô hạn</span>
                </h1>
                <p class="hero-subtitle">
                    Hàng nghìn đầu sách chất lượng cao, từ sách văn học đến khoa học,
                    kinh doanh và phát triển bản thân — tất cả chỉ trong một nơi.
                </p>

                @if (isLoggedIn)
                {
                    <div class="d-flex align-items-center gap-3">
                        <div class="user-avatar-nav" style="width: 44px; height: 44px; font-size: 1rem;">
                            @userName[0].ToString().ToUpper()
                        </div>
                        <div>
                            <div style="font-size: 0.85rem; color: var(--text-muted);">Xin chào,</div>
                            <div style="font-weight: 600; color: var(--text-light);">@userName 👋</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="d-flex gap-3 flex-wrap">
                        <a asp-controller="Account" asp-action="Register"
                           class="btn-nav-register" style="padding: 0.75rem 2rem; font-size: 1rem; border-radius: 30px; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;">
                            <i class="bi bi-person-plus"></i> Đăng ký miễn phí
                        </a>
                        <a asp-controller="Account" asp-action="Login"
                           class="btn-nav-login" style="padding: 0.75rem 2rem; font-size: 1rem; border-radius: 30px; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;">
                            <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                        </a>
                    </div>
                }

                <div class="hero-stats">
                    <div class="stat-item">
                        <span class="stat-number">@Model.TotalCount+</span>
                        <span class="stat-label">Đầu sách</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number">100%</span>
                        <span class="stat-label">Chính hãng</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-number">24/7</span>
                        <span class="stat-label">Hỗ trợ</span>
                    </div>
                </div>
            </div>
            <div class="col-md-5 d-none d-md-flex justify-content-center">
                <div class="hero-image-zone">
                    <div class="book-stack">
                        <div class="book-card-deco b1"></div>
                        <div class="book-card-deco b2"></div>
                        <div class="book-card-deco b3"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== SEARCH & FILTER SECTION ===== -->
<section class="search-section">
    <div class="container">
        <form method="get" asp-controller="Home" asp-action="Index" id="filterForm">
            <!-- Search Bar -->
            <div class="search-form" style="margin-bottom: 1rem;">
                <input type="text"
                       name="search"
                       value="@searchVal"
                       class="search-input"
                       placeholder="🔍  Tìm kiếm theo tên sách, tác giả..." />
                <button type="submit" class="btn-search">
                    <i class="bi bi-search me-1"></i> Tìm kiếm
                </button>
                @if (!string.IsNullOrEmpty(searchVal) || Model.CategoryId.HasValue || !string.IsNullOrEmpty(Model.PriceSort))
                {
                    <a asp-controller="Home" asp-action="Index"
                       style="display: flex; align-items: center; color: var(--text-muted); font-size: 0.85rem; white-space: nowrap;">
                        <i class="bi bi-x-circle me-1"></i> Xóa lọc
                    </a>
                }
            </div>

            <!-- Filters Row -->
            <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center;">
                <!-- Category Filter -->
                <select name="categoryId" class="filter-select" onchange="this.form.submit()">
                    <option value="">📚 Tất cả thể loại</option>
                    @foreach (var cat in Model.Categories)
                    {
                        if (Model.CategoryId == cat.Id)
                        {
                            <option value="@cat.Id" selected>@cat.Name</option>
                        }
                        else
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    }
                </select>

                <!-- Price Sort -->
                <select name="priceSort" class="filter-select" onchange="this.form.submit()">
                    <option value="">💰 Sắp xếp theo giá</option>
                    @if (Model.PriceSort == "asc")
                    {
                        <option value="asc" selected>⬆ Giá thấp → cao</option>
                        <option value="desc">⬇ Giá cao → thấp</option>
                    }
                    else if (Model.PriceSort == "desc")
                    {
                        <option value="asc">⬆ Giá thấp → cao</option>
                        <option value="desc" selected>⬇ Giá cao → thấp</option>
                    }
                    else
                    {
                        <option value="asc">⬆ Giá thấp → cao</option>
                        <option value="desc">⬇ Giá cao → thấp</option>
                    }
                </select>
            </div>
        </form>
    </div>
</section>


<!-- ===== BOOKS SECTION ===== -->
<section class="books-section">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">
                @if (!string.IsNullOrEmpty(searchVal))
                {
                    <span>Kết quả cho "<span class="gold">@searchVal</span>"</span>
                }
                else if (Model.CategoryId.HasValue)
                {
                    var catName = Model.Categories.FirstOrDefault(c => c.Id == Model.CategoryId)?.Name ?? "Thể loại";
                    <span>Sách <span class="gold">@catName</span></span>
                }
                else
                {
                    <span>Tất cả <span class="gold">sách</span></span>
                }
            </h2>
            <span class="books-count">
                <i class="bi bi-book me-1"></i>@Model.TotalCount cuốn sách
            </span>
        </div>

        @if (Model.Books == null || Model.Books.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">📭</div>
                <h4>Không tìm thấy sách nào</h4>
                <p>
                    @if (!string.IsNullOrEmpty(searchVal))
                    {
                        <span>Không có kết quả cho "@searchVal". Hãy thử từ khóa khác.</span>
                    }
                    else
                    {
                        <span>Chưa có sách nào phù hợp với bộ lọc. Hãy thử điều chỉnh.</span>
                    }
                </p>
                <a asp-controller="Home" asp-action="Index" style="color: var(--primary);">
                    <i class="bi bi-arrow-left me-1"></i> Xem tất cả sách
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var book in Model.Books)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="book-card">
                            <!-- Book Cover -->
                            <div class="book-card-img">
                                @if (!string.IsNullOrEmpty(book.ImageUrl))
                                {
                                    <img src="@book.ImageUrl" alt="@book.Title" loading="lazy" />
                                }
                                else
                                {
                                    <div class="book-placeholder-icon">📖</div>
                                }
                                <span class="book-category-badge">@book.CategoryName</span>
                                @if (book.DiscountPercent > 0)
                                {
                                    <span class="book-discount-badge">-@book.DiscountPercent%</span>
                                }
                            </div>

                            <!-- Book Body -->
                            <div class="book-card-body">
                                <h3 class="book-title" title="@book.Title">@book.Title</h3>
                                <p class="book-author">bởi <span>@book.Author</span></p>
                                <p class="book-desc">@book.Description</p>

                                <div class="book-footer">
                                    @if (book.DiscountPercent > 0 && book.DiscountedPrice.HasValue)
                                    {
                                        <div>
                                            <span class="book-price" style="color:#f59e0b">@book.DiscountedPrice.Value.ToString("N0")₫</span>
                                            <span style="font-size:.75rem;color:var(--text-muted);text-decoration:line-through;margin-left:.3rem">@book.Price.ToString("N0")₫</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="book-price">@book.Price.ToString("N0")₫</span>
                                    }
                                    <span class="book-stock @(book.StockQuantity > 0 ? "in-stock" : "out-stock")">
                                        @if (book.StockQuantity > 0)
                                        {
                                            <i class="bi bi-check-circle-fill me-1"></i>
                                            <span>Còn hàng</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-x-circle-fill me-1"></i>
                                            <span>Hết hàng</span>
                                        }
                                    </span>
                                </div>

                                <!-- Star rating row -->
                                <div class="book-rating-row">
                                    @if (book.ReviewCount > 0)
                                    {
                                        <span class="book-stars">
                                            @for (int s = 1; s <= 5; s++)
                                            {
                                                if (s <= Math.Floor(book.AverageRating))
                                                {
                                                    <i class="bi bi-star-fill"></i>
                                                }
                                                else if (s - book.AverageRating < 1 && s - book.AverageRating > 0)
                                                {
                                                    <i class="bi bi-star-half"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-star"></i>
                                                }
                                            }
                                        </span>
                                        <span class="book-rating-text">@book.AverageRating <span class="book-review-count">(@book.ReviewCount)</span></span>
                                    }
                                    else
                                    {
                                        <span class="book-rating-text" style="color: var(--text-muted); opacity:0.5;">Chưa có đánh giá</span>
                                    }
                                </div>

                                <div class="d-flex gap-2 mt-1">
                                    <a asp-controller="Home" asp-action="Detail" asp-route-id="@book.Id"
                                       class="btn-detail-book" style="flex: 1; text-align: center; text-decoration: none;">
                                        <i class="bi bi-eye me-1"></i> Xem chi tiết
                                    </a>
                                </div>
                                @if (isLoggedIn)
                                {
                                    <form method="post" asp-controller="Cart" asp-action="Add" style="margin-top: 0.4rem;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="bookId" value="@book.Id" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <input type="hidden" name="returnUrl" value="/" />
                                        <button type="submit" class="btn-add-cart" style="width:100%;">
                                            <i class="bi bi-cart-plus me-1"></i> Thêm vào giỏ
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <a asp-controller="Account" asp-action="Login"
                                       class="btn-add-cart" style="display: block; text-align: center; text-decoration: none; margin-top: 0.4rem;">
                                        <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập để mua
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div style="display: flex; justify-content: center; align-items: center; gap: 0.5rem; margin-top: 2.5rem; flex-wrap: wrap;">
                    @if (Model.Page > 1)
                    {
                        <a asp-controller="Home" asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-priceSort="@Model.PriceSort"
                           asp-route-page="@(Model.Page - 1)"
                           class="page-btn">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    }

                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <a asp-controller="Home" asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-priceSort="@Model.PriceSort"
                           asp-route-page="@p"
                           class="page-btn @(p == Model.Page ? "active" : "")">
                            @p
                        </a>
                    }

                    @if (Model.Page < Model.TotalPages)
                    {
                        <a asp-controller="Home" asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-priceSort="@Model.PriceSort"
                           asp-route-page="@(Model.Page + 1)"
                           class="page-btn">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    }
                </div>
                <p style="text-align: center; color: var(--text-muted); font-size: 0.82rem; margin-top: 0.75rem;">
                    Trang @Model.Page / @Model.TotalPages · @Model.TotalCount sách
                </p>
            }
        }
    </div>
</section>

@section Styles {
<style>
    .filter-select, .filter-input {
        background: rgba(255,255,255,0.05);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 0.55rem 1rem;
        color: var(--text-light);
        font-size: 0.88rem;
        outline: none;
        transition: border-color 0.2s;
    }
    .filter-select:focus, .filter-input:focus { border-color: rgba(201,168,76,0.5); }
    .filter-select option { background: #16181f; }
    .filter-input::placeholder { color: var(--text-muted); }

    .btn-filter {
        background: rgba(201,168,76,0.12);
        border: 1px solid rgba(201,168,76,0.35);
        color: var(--primary);
        border-radius: 10px;
        padding: 0.55rem 1.25rem;
        font-size: 0.88rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }
    .btn-filter:hover { background: var(--primary); color: #0a0a0f; }

    .page-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px; height: 38px;
        border-radius: 10px;
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        color: var(--text-muted);
        border: 1px solid var(--border-color);
        background: rgba(255,255,255,0.03);
        transition: all 0.2s;
    }
    .page-btn:hover { border-color: rgba(201,168,76,0.4); color: var(--primary); }
    .page-btn.active { background: var(--primary); color: #0a0a0f; border-color: var(--primary); font-weight: 700; }

    /* Star ratings on book cards */
    .book-rating-row { display: flex; align-items: center; gap: 0.4rem; margin: 0.35rem 0 0.1rem; font-size: 0.8rem; }
    .book-stars { color: #f59e0b; font-size: 0.82rem; letter-spacing: 0.02em; }
    .book-rating-text { color: #f59e0b; font-weight: 600; font-size: 0.8rem; }
    .book-review-count { color: var(--text-muted); font-weight: 400; }

    /* Discount badge on book cover */
    .book-discount-badge {
        position: absolute;
        top: 8px; left: 8px;
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: white;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.22rem 0.55rem;
        border-radius: 20px;
        letter-spacing: 0.03em;
        box-shadow: 0 2px 8px rgba(239,68,68,0.5);
        z-index: 2;
    }
</style>
}
