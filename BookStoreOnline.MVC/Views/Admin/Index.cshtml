@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var totalBooks = (int)(ViewData["TotalBooks"] ?? 0);
    var totalCategories = (int)(ViewData["TotalCategories"] ?? 0);
    var totalStock = (int)(ViewData["TotalStock"] ?? 0);
    var recentBooks = ViewData["RecentBooks"] as List<BookStoreOnline.MVC.Models.BookViewModel> ?? new();
}

<!-- Stat Cards -->
<div class="page-header">
    <div>
        <div class="page-header-title">📊 Dashboard</div>
        <div class="page-header-sub">Chào mừng trở lại, @Context.Session.GetString("UserFullName")!</div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="stat-card primary">
            <i class="bi bi-book stat-icon"></i>
            <div class="stat-label">Tổng số sách</div>
            <div class="stat-value">@totalBooks</div>
            <a asp-controller="Admin" asp-action="Books" style="font-size:0.78rem; color: var(--primary-light); text-decoration:none;">
                Quản lý sách <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card success">
            <i class="bi bi-tag stat-icon"></i>
            <div class="stat-label">Danh mục</div>
            <div class="stat-value">@totalCategories</div>
            <a asp-controller="Admin" asp-action="Categories" style="font-size:0.78rem; color: var(--success); text-decoration:none;">
                Quản lý danh mục <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card warning">
            <i class="bi bi-boxes stat-icon"></i>
            <div class="stat-label">Tổng tồn kho</div>
            <div class="stat-value">@totalStock.ToString("N0")</div>
            <span style="font-size:0.78rem; color: var(--text-muted);">Cuốn sách</span>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="admin-card" style="border: 1px dashed rgba(99,102,241,0.3);">
            <div class="d-flex align-items-center gap-3">
                <div style="width:48px;height:48px;background:var(--primary-glow);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;">📖</div>
                <div>
                    <div style="font-weight:600;">Thêm sách mới</div>
                    <div style="font-size:0.8rem;color:var(--text-muted);">Thêm đầu sách mới vào kho</div>
                </div>
                <a asp-controller="Admin" asp-action="BookCreate" class="btn-admin-primary ms-auto">
                    <i class="bi bi-plus-lg"></i> Thêm
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="admin-card" style="border: 1px dashed rgba(34,197,94,0.3);">
            <div class="d-flex align-items-center gap-3">
                <div style="width:48px;height:48px;background:rgba(34,197,94,0.1);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;">🏷️</div>
                <div>
                    <div style="font-weight:600;">Thêm danh mục</div>
                    <div style="font-size:0.8rem;color:var(--text-muted);">Tạo danh mục sách mới</div>
                </div>
                <a asp-controller="Admin" asp-action="CategoryCreate" class="btn-admin-primary ms-auto" style="background: linear-gradient(135deg,#059669,#22c55e);box-shadow:0 4px 15px rgba(34,197,94,0.2);">
                    <i class="bi bi-plus-lg"></i> Thêm
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Recent Books -->
<div class="admin-card">
    <div class="admin-card-title">
        <i class="bi bi-clock-history" style="color:var(--primary-light);"></i>
        Sách trong hệ thống (5 gần nhất)
    </div>
    @if (!recentBooks.Any())
    {
        <div style="text-align:center;padding:2rem;color:var(--text-muted);">
            <i class="bi bi-inbox" style="font-size:2rem;display:block;margin-bottom:0.5rem;"></i>
            Chưa có sách nào. <a asp-controller="Admin" asp-action="BookCreate" style="color:var(--primary-light);">Thêm ngay!</a>
        </div>
    }
    else
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Sách</th>
                    <th>Tác giả</th>
                    <th>Danh mục</th>
                    <th>Giá</th>
                    <th>Tồn kho</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in recentBooks)
                {
                    <tr>
                        <td>
                            <div style="font-weight:600;">@book.Title</div>
                        </td>
                        <td style="color:var(--text-muted);">@book.Author</td>
                        <td><span class="badge-admin badge-primary">@(book.CategoryName ?? "N/A")</span></td>
                        <td style="color:var(--warning);font-weight:600;">@book.Price.ToString("N0") ₫</td>
                        <td>
                            @if (book.StockQuantity > 0)
                            {
                                <span class="badge-admin badge-success">@book.StockQuantity</span>
                            }
                            else
                            {
                                <span class="badge-admin" style="background:rgba(239,68,68,0.1);color:var(--danger);border:1px solid rgba(239,68,68,0.3);">Hết hàng</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="mt-3">
            <a asp-controller="Admin" asp-action="Books" class="btn-admin-secondary" style="font-size:0.8rem;">
                <i class="bi bi-arrow-right"></i> Xem tất cả sách
            </a>
        </div>
    }
</div>
