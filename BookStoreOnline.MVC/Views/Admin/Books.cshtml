@model List<BookStoreOnline.MVC.Models.BookViewModel>
@{
    ViewData["Title"] = "Quản lý Sách";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <div>
        <div class="page-header-title">📖 Quản lý Sách</div>
        <div class="page-header-sub">Tổng cộng @Model.Count đầu sách</div>
    </div>
    <a asp-controller="Admin" asp-action="BookCreate" class="btn-admin-primary">
        <i class="bi bi-plus-lg"></i> Thêm sách
    </a>
</div>

<div class="admin-card">
    @if (!Model.Any())
    {
        <div style="text-align:center;padding:3rem;color:var(--text-muted);">
            <i class="bi bi-book" style="font-size:3rem;display:block;margin-bottom:1rem;opacity:0.3;"></i>
            <p>Chưa có sách nào trong kho.</p>
            <a asp-controller="Admin" asp-action="BookCreate" class="btn-admin-primary">
                <i class="bi bi-plus-lg"></i> Thêm sách đầu tiên
            </a>
        </div>
    }
    else
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th style="width:60px;">#</th>
                    <th style="width:55px;">Ảnh</th>
                    <th>Tiêu đề</th>
                    <th>Tác giả</th>
                    <th>Danh mục</th>
                    <th>Giá Bán</th>
                    <th>Giá Nhập</th>
                    <th>Kho</th>
                    <th style="width:160px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    var book = Model[i];
                    <tr>
                        <td style="color:var(--text-light);font-size:0.8rem;">@(i + 1)</td>
                        <td>
                            @if (!string.IsNullOrEmpty(book.ImageUrl))
                            {
                                <img src="@book.ImageUrl" alt="@book.Title" class="book-thumb"
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                                <div class="book-thumb-placeholder" style="display:none;"><i class="bi bi-book"></i></div>
                            }
                            else
                            {
                                <div class="book-thumb-placeholder"><i class="bi bi-book"></i></div>
                            }
                        </td>
                        <td>
                            <div style="font-weight:600;max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@book.Title">
                                @book.Title
                            </div>
                        </td>
                        <td style="color:var(--text-muted);font-size:0.85rem;">@book.Author</td>
                        <td><span class="badge-admin badge-primary">@(book.CategoryName ?? "N/A")</span></td>
                        <td style="color:var(--warning);font-weight:600;white-space:nowrap;">
                            @book.Price.ToString("N0") ₫
                        </td>
                        <td style="color:var(--text-muted);font-size:0.85rem;white-space:nowrap;">
                            @book.ImportPrice.ToString("N0") ₫
                        </td>
                        <td>
                            @if (book.StockQuantity > 0)
                            {
                                <span class="badge-admin badge-success">@book.StockQuantity</span>
                            }
                            else
                            {
                                <span class="badge-admin" style="background:rgba(239,68,68,0.1);color:var(--danger);border:1px solid rgba(239,68,68,0.3);">Hết</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-controller="Admin" asp-action="BookEdit" asp-route-id="@book.Id"
                                   class="btn-admin-edit">
                                    <i class="bi bi-pencil"></i> Sửa
                                </a>
                                <form id="delBook_@book.Id" asp-controller="Admin" asp-action="BookDelete"
                                      asp-route-id="@book.Id" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn-admin-delete"
                                            onclick="confirmDelete('delBook_@book.Id', '@book.Title.Replace("'", "\\'")')">
                                        <i class="bi bi-trash3"></i> Xóa
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
