<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="BookStore Online - Thiên đường sách của bạn" />
    <title>@ViewData["Title"] - BookStore Online</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Custom Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ===== NAVBAR ===== -->
    <nav class="navbar-book">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between w-100">

                <!-- Logo -->
                <a asp-controller="Home" asp-action="Index" class="navbar-brand">
                    <span class="brand-icon">📚</span>
                    BookStore
                </a>

                <!-- Desktop Nav -->
                <div class="d-none d-md-flex align-items-center gap-1">
                    <a asp-controller="Home" asp-action="Index" class="nav-link">
                        <i class="bi bi-house me-1"></i>Trang chủ
                    </a>
                </div>

                <!-- Auth Buttons -->
                <div class="d-none d-md-flex align-items-center gap-2">
                    @if (Context.Session.GetString("UserEmail") != null)
                    {
                        <!-- Đã đăng nhập -->
                        <div class="dropdown user-dropdown">
                            <button class="btn btn-link nav-link d-flex align-items-center gap-2 text-decoration-none"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="user-avatar-nav">
                                    @(Context.Session.GetString("UserFullName")?[0].ToString().ToUpper() ?? "U")
                                </div>
                                <span style="color: var(--text-main); font-size: 0.9rem;">
                                    @Context.Session.GetString("UserFullName")
                                </span>
                                <i class="bi bi-chevron-down" style="font-size: 0.75rem; color: var(--text-muted);"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <span class="dropdown-item-text text-muted" style="font-size: 0.78rem; padding: 0.5rem 1rem;">
                                        <i class="bi bi-person-circle me-1"></i>@Context.Session.GetString("UserRole")
                                    </span>
                                </li>
                                @if (Context.Session.GetString("UserRole") == "Admin")
                                {
                                    <li><hr class="dropdown-divider" style="border-color: var(--border-color);"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Index">
                                            <i class="bi bi-shield-lock me-2" style="color: var(--primary);"></i>Admin Panel
                                        </a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider" style="border-color: var(--border-color);"></li>
                                <li>
                                    <a class="dropdown-item text-danger"
                                       asp-controller="Account" asp-action="Logout">
                                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <!-- Chưa đăng nhập -->
                        <a asp-controller="Account" asp-action="Login" class="nav-link btn-nav-login">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="nav-link btn-nav-register">
                            <i class="bi bi-person-plus me-1"></i>Đăng ký
                        </a>
                    }
                </div>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler d-md-none border-0" type="button"
                        data-bs-toggle="collapse" data-bs-target="#mobileMenu">
                    <i class="bi bi-list" style="font-size: 1.5rem; color: var(--text-muted);"></i>
                </button>
            </div>

            <!-- Mobile Menu -->
            <div class="collapse" id="mobileMenu">
                <div class="pt-3 pb-1 border-top mt-2" style="border-color: var(--border-color) !important;">
                    <a asp-controller="Home" asp-action="Index" class="nav-link d-block mb-1">
                        <i class="bi bi-house me-2"></i>Trang chủ
                    </a>
                    @if (Context.Session.GetString("UserEmail") != null)
                    {
                        <hr style="border-color: var(--border-color);">
                        <div class="d-flex align-items-center gap-2 px-2 mb-2">
                            <div class="user-avatar-nav">
                                @(Context.Session.GetString("UserFullName")?[0].ToString().ToUpper() ?? "U")
                            </div>
                            <span style="color: var(--text-main); font-size: 0.9rem;">
                                @Context.Session.GetString("UserFullName")
                            </span>
                        </div>
                        @if (Context.Session.GetString("UserRole") == "Admin")
                        {
                            <a asp-controller="Admin" asp-action="Index" class="nav-link d-block mb-1">
                                <i class="bi bi-shield-lock me-2" style="color: var(--primary);"></i>Admin Panel
                            </a>
                        }
                        <a asp-controller="Account" asp-action="Logout"
                           class="nav-link text-danger-book d-block" style="color: #f87171;">
                            <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                        </a>
                    }
                    else
                    {
                        <hr style="border-color: var(--border-color);">
                        <a asp-controller="Account" asp-action="Login" class="nav-link d-block mb-1">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="nav-link d-block">
                            <i class="bi bi-person-plus me-2"></i>Đăng ký
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- ===== TOAST NOTIFICATION ===== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="toast-container-book" id="toastContainer">
            <div class="toast-book success" id="toastMsg">
                <i class="bi bi-check-circle-fill" style="color: #4ade80; font-size: 1.1rem; flex-shrink: 0;"></i>
                <span class="toast-text">@TempData["SuccessMessage"]</span>
                <button class="toast-close" onclick="dismissToast()">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>
    }

    <!-- ===== MAIN CONTENT ===== -->
    <main>
        @RenderBody()
    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="footer-book">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4 mb-md-0">
                    <div class="footer-brand">
                        📚 BookStore
                    </div>
                    <p class="footer-desc">
                        Thiên đường sách của bạn. Khám phá hàng nghìn đầu sách từ nhiều thể loại khác nhau.
                    </p>
                </div>
                <div class="col-md-3 mb-3 mb-md-0">
                    <h6 class="footer-heading">Điều hướng</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        @if (Context.Session.GetString("UserEmail") == null)
                        {
                            <li><a asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
                            <li><a asp-controller="Account" asp-action="Register">Đăng ký</a></li>
                        }
                    </ul>
                </div>
                <div class="col-md-5">
                    <h6 class="footer-heading">Kết nối với chúng tôi</h6>
                    <p class="footer-desc">Theo dõi chúng tôi để cập nhật những đầu sách mới nhất.</p>
                    <div class="d-flex gap-3 mt-2">
                        <a href="#" style="color: var(--text-muted); font-size: 1.3rem; transition: color 0.3s ease;" onmouseover="this.style.color='var(--primary)'" onmouseout="this.style.color='var(--text-muted)'">
                            <i class="bi bi-facebook"></i>
                        </a>
                        <a href="#" style="color: var(--text-muted); font-size: 1.3rem; transition: color 0.3s ease;" onmouseover="this.style.color='var(--primary)'" onmouseout="this.style.color='var(--text-muted)'">
                            <i class="bi bi-instagram"></i>
                        </a>
                        <a href="#" style="color: var(--text-muted); font-size: 1.3rem; transition: color 0.3s ease;" onmouseover="this.style.color='var(--primary)'" onmouseout="this.style.color='var(--text-muted)'">
                            <i class="bi bi-twitter-x"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <span>&copy; @DateTime.Now.Year <strong style="color: var(--primary);">BookStore Online</strong>. Tất cả quyền được bảo lưu.</span>
            </div>
        </div>
    </footer>

    <!-- ===== SCRIPTS ===== -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Toast auto-dismiss
        function dismissToast() {
            var toast = document.getElementById('toastMsg');
            var container = document.getElementById('toastContainer');
            if (toast) {
                toast.style.animation = 'slideOut 0.3s ease forwards';
                setTimeout(() => { if (container) container.remove(); }, 350);
            }
        }
        // Auto dismiss sau 4s
        setTimeout(dismissToast, 4000);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
