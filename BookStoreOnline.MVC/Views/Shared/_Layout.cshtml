<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="BookStore Online - Thiên đường sách của bạn" />
    <title>@ViewData["Title"] - BookStore Online</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Custom Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ===== NAVBAR ===== -->
    <nav class="navbar-book">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between w-100">

                <!-- Logo -->
                <a asp-controller="Home" asp-action="Index" class="navbar-brand">
                    <span class="brand-icon">📚</span>
                    BookStore
                </a>

                <!-- Desktop Nav -->
                <div class="d-none d-md-flex align-items-center gap-1">
                    <a asp-controller="Home" asp-action="Index" class="nav-link">
                        <i class="bi bi-house me-1"></i>Trang chủ
                    </a>
                </div>

                <!-- Auth Buttons -->
                <div class="d-none d-md-flex align-items-center gap-2">
                    @if (Context.Session.GetString("UserEmail") != null)
                    {
                        <!-- Đã đăng nhập -->
                        <!-- Giỏ hàng icon -->
                        <a asp-controller="Cart" asp-action="Index"
                           class="nav-link position-relative cart-icon-btn"
                           title="Giỏ hàng" style="font-size: 1.3rem; color: var(--text-muted); padding: 0.25rem 0.5rem; transition: color 0.2s;">
                            <i class="bi bi-cart3"></i>
                        </a>

                        <!-- Chuông thông báo user -->
                        <div class="position-relative" id="userBellWrap">
                            <button id="userBellBtn" onclick="toggleUserBell()"
                                    style="background:none;border:none;font-size:1.3rem;color:var(--text-muted);padding:.25rem .5rem;cursor:pointer;position:relative;transition:color .2s"
                                    title="Thông báo">
                                <i class="bi bi-bell"></i>
                                <span id="userBellBadge" style="display:none;position:absolute;top:-2px;right:-2px;background:#ef4444;color:#fff;font-size:.6rem;font-weight:700;border-radius:50%;width:16px;height:16px;line-height:16px;text-align:center">0</span>
                            </button>
                            <div id="userBellPanel" style="display:none;position:absolute;top:calc(100% + 8px);right:0;width:320px;background:#1e2130;border:1px solid rgba(255,255,255,.1);border-radius:14px;box-shadow:0 20px 60px rgba(0,0,0,.5);z-index:9999;overflow:hidden">
                                <div style="padding:.75rem 1rem;border-bottom:1px solid rgba(255,255,255,.07);display:flex;align-items:center;justify-content:space-between">
                                    <span style="font-weight:600;font-size:.85rem;color:#e2e8f0">🔔 Thông báo</span>
                                    <button onclick="markAllRead()" style="background:none;border:none;color:#818cf8;font-size:.75rem;cursor:pointer">§ánh dấu tất cả đã đọc</button>
                                </div>
                                <div id="userNotifList" style="max-height:320px;overflow-y:auto"></div>
                            </div>
                        </div>

                        <div class="dropdown user-dropdown">
                            <button class="btn btn-link nav-link d-flex align-items-center gap-2 text-decoration-none"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="user-avatar-nav">
                                    @(Context.Session.GetString("UserFullName")?[0].ToString().ToUpper() ?? "U")
                                </div>
                                <span style="color: var(--text-main); font-size: 0.9rem;">
                                    @Context.Session.GetString("UserFullName")
                                </span>
                                <i class="bi bi-chevron-down" style="font-size: 0.75rem; color: var(--text-muted);"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <span class="dropdown-item-text text-muted" style="font-size: 0.78rem; padding: 0.5rem 1rem;">
                                        <i class="bi bi-person-circle me-1"></i>@Context.Session.GetString("UserRole")
                                    </span>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                        <i class="bi bi-person-lines-fill me-2" style="color: var(--primary);"></i>Hồ sơ cá nhân
                                    </a>
                                </li>
                                @if (Context.Session.GetString("UserRole") == "Admin")
                                {
                                    <li><hr class="dropdown-divider" style="border-color: var(--border-color);"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Index">
                                            <i class="bi bi-shield-lock me-2" style="color: var(--primary);"></i>Admin Panel
                                        </a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider" style="border-color: var(--border-color);"></li>
                                <li>
                                    <a class="dropdown-item text-danger"
                                       asp-controller="Account" asp-action="Logout">
                                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <!-- Chưa đăng nhập -->
                        <a asp-controller="Account" asp-action="Login" class="nav-link btn-nav-login">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="nav-link btn-nav-register">
                            <i class="bi bi-person-plus me-1"></i>Đăng ký
                        </a>
                    }
                </div>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler d-md-none border-0" type="button"
                        data-bs-toggle="collapse" data-bs-target="#mobileMenu">
                    <i class="bi bi-list" style="font-size: 1.5rem; color: var(--text-muted);"></i>
                </button>
            </div>

            <!-- Mobile Menu -->
            <div class="collapse" id="mobileMenu">
                <div class="pt-3 pb-1 border-top mt-2" style="border-color: var(--border-color) !important;">
                    <a asp-controller="Home" asp-action="Index" class="nav-link d-block mb-1">
                        <i class="bi bi-house me-2"></i>Trang chủ
                    </a>
                    @if (Context.Session.GetString("UserEmail") != null)
                    {
                        <hr style="border-color: var(--border-color);">
                        <div class="d-flex align-items-center gap-2 px-2 mb-2">
                            <div class="user-avatar-nav">
                                @(Context.Session.GetString("UserFullName")?[0].ToString().ToUpper() ?? "U")
                            </div>
                            <span style="color: var(--text-main); font-size: 0.9rem;">
                                @Context.Session.GetString("UserFullName")
                            </span>
                        </div>
                        <a asp-controller="Cart" asp-action="Index" class="nav-link d-block mb-1">
                            <i class="bi bi-cart3 me-2" style="color: var(--primary);"></i>Giỏ hàng
                        </a>
                        <a asp-controller="Account" asp-action="Profile" class="nav-link d-block mb-1">
                            <i class="bi bi-person-lines-fill me-2" style="color: var(--primary);"></i>Hồ sơ cá nhân
                        </a>
                        @if (Context.Session.GetString("UserRole") == "Admin")
                        {
                            <a asp-controller="Admin" asp-action="Index" class="nav-link d-block mb-1">
                                <i class="bi bi-shield-lock me-2" style="color: var(--primary);"></i>Admin Panel
                            </a>
                        }
                        <a asp-controller="Account" asp-action="Logout"
                           class="nav-link text-danger-book d-block" style="color: #f87171;">
                            <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                        </a>
                    }
                    else
                    {
                        <hr style="border-color: var(--border-color);">
                        <a asp-controller="Account" asp-action="Login" class="nav-link d-block mb-1">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="nav-link d-block">
                            <i class="bi bi-person-plus me-2"></i>Đăng ký
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- ===== TOAST NOTIFICATION ===== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="toast-container-book" id="toastSuccess">
            <div class="toast-book success" id="toastMsgSuccess">
                <i class="bi bi-check-circle-fill" style="color: #4ade80; font-size: 1.1rem; flex-shrink: 0;"></i>
                <span class="toast-text">@TempData["SuccessMessage"]</span>
                <button class="toast-close" onclick="dismissToast('toastSuccess')">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="toast-container-book" id="toastError" style="bottom: calc(2rem + @(TempData["SuccessMessage"] != null ? "5rem" : "0px"))">
            <div class="toast-book" id="toastMsgError"
                 style="background:rgba(248,113,113,0.12);border:1px solid rgba(248,113,113,0.3);color:#f87171;">
                <i class="bi bi-exclamation-triangle-fill" style="color: #f87171; font-size: 1.1rem; flex-shrink: 0;"></i>
                <span class="toast-text">@TempData["ErrorMessage"]</span>
                <button class="toast-close" onclick="dismissToast('toastError')">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>
    }

    <!-- ===== MAIN CONTENT ===== -->
    <main>
        @RenderBody()
    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="footer-book">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4 mb-md-0">
                    <div class="footer-brand">
                        📚 BookStore
                    </div>
                    <p class="footer-desc">
                        Thiên đường sách của bạn. Khám phá hàng nghìn đầu sách từ nhiều thể loại khác nhau.
                    </p>
                </div>
                <div class="col-md-3 mb-3 mb-md-0">
                    <h6 class="footer-heading">Điều hướng</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        @if (Context.Session.GetString("UserEmail") == null)
                        {
                            <li><a asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
                            <li><a asp-controller="Account" asp-action="Register">Đăng ký</a></li>
                        }
                    </ul>
                </div>
                <div class="col-md-5">
                    <h6 class="footer-heading">Kết nối với chúng tôi</h6>
                    <p class="footer-desc">Theo dõi chúng tôi để cập nhật những đầu sách mới nhất.</p>
                    <div class="d-flex gap-3 mt-2">
                        <a href="#" style="color: var(--text-muted); font-size: 1.3rem; transition: color 0.3s ease;" onmouseover="this.style.color='var(--primary)'" onmouseout="this.style.color='var(--text-muted)'">
                            <i class="bi bi-facebook"></i>
                        </a>
                        <a href="#" style="color: var(--text-muted); font-size: 1.3rem; transition: color 0.3s ease;" onmouseover="this.style.color='var(--primary)'" onmouseout="this.style.color='var(--text-muted)'">
                            <i class="bi bi-instagram"></i>
                        </a>
                        <a href="#" style="color: var(--text-muted); font-size: 1.3rem; transition: color 0.3s ease;" onmouseover="this.style.color='var(--primary)'" onmouseout="this.style.color='var(--text-muted)'">
                            <i class="bi bi-twitter-x"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <span>&copy; @DateTime.Now.Year <strong style="color: var(--primary);">BookStore Online</strong>. Tất cả quyền được bảo lưu.</span>
            </div>
        </div>
    </footer>

    <!-- ===== SCRIPTS ===== -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function dismissToast(id) {
            var container = document.getElementById(id);
            if (container) {
                container.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
                container.style.opacity = '0';
                container.style.transform = 'translateX(20px)';
                setTimeout(() => container.remove(), 320);
            }
        }
        // Auto-dismiss sau 3s
        setTimeout(() => dismissToast('toastSuccess'), 3000);
        setTimeout(() => dismissToast('toastError'), 3000);
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    @if (Context.Session.GetString("UserEmail") != null)
    {
        <script>
            // ===== USER BELL NOTIFICATION =====
            var userBellOpen = false;

            function toggleUserBell() {
                userBellOpen = !userBellOpen;
                document.getElementById('userBellPanel').style.display = userBellOpen ? 'block' : 'none';
                if (userBellOpen) loadUserNotifications();
            }

            function loadUserNotifications() {
                fetch('/Home/GetNotifications')
                    .then(r => r.json())
                    .then(data => {
                        updateBellBadge(data.unread);
                        var list = document.getElementById('userNotifList');
                        if (!data.notifications || data.notifications.length === 0) {
                            list.innerHTML = '<div style="padding:1.5rem;text-align:center;color:#94a3b8;font-size:.85rem">🔔 Chưa có thông báo nào</div>';
                            return;
                        }
                        list.innerHTML = data.notifications.map(n => {
                            var icon = n.type === 'Discount' ? '🎉' : '📦';
                            var readStyle = n.isRead ? 'opacity:.6' : 'font-weight:600';
                            var bg = n.isRead ? '' : 'background:rgba(99,102,241,.07);';
                            return '<div style="padding:.75rem 1rem;border-bottom:1px solid rgba(255,255,255,.05);cursor:pointer;' + bg + readStyle + '" onclick="markRead(' + n.id + ', this)">' +
                                '<div style="display:flex;gap:.6rem;align-items:flex-start">' +
                                '<span style="font-size:1.1rem;flex-shrink:0">' + icon + '</span>' +
                                '<div><div style="font-size:.82rem;color:#e2e8f0">' + n.title + '</div>' +
                                (n.message ? '<div style="font-size:.76rem;color:#94a3b8;margin-top:.2rem">' + n.message + '</div>' : '') +
                                '<div style="font-size:.7rem;color:#64748b;margin-top:.2rem">' + new Date(n.createdAt).toLocaleString('vi-VN') + '</div>' +
                                '</div></div></div>';
                        }).join('');
                    })
                    .catch(() => {});
            }

            function updateBellBadge(count) {
                var badge = document.getElementById('userBellBadge');
                var btn = document.getElementById('userBellBtn');
                if (count > 0) {
                    badge.textContent = count > 9 ? '9+' : count;
                    badge.style.display = 'block';
                    btn.style.color = '#f59e0b';
                } else {
                    badge.style.display = 'none';
                    btn.style.color = '';
                }
            }

            function markRead(id, el) {
                fetch('/Home/MarkNotificationRead?id=' + id, { method: 'POST', headers: { 'RequestVerificationToken': document.querySelector('[name=__RequestVerificationToken]')?.value || '' } })
                    .then(() => { el.style.opacity = '.6'; el.style.fontWeight = '400'; el.style.background = ''; loadUserNotifications(); })
                    .catch(() => {});
            }

            function markAllRead() {
                fetch('/Home/MarkAllNotificationsRead', { method: 'POST' })
                    .then(() => loadUserNotifications())
                    .catch(() => {});
            }

            // Close when clicking outside
            document.addEventListener('click', function(e) {
                if (userBellOpen && !e.target.closest('#userBellWrap')) {
                    document.getElementById('userBellPanel').style.display = 'none';
                    userBellOpen = false;
                }
            });

            // Load on page open + poll every 30s
            loadUserNotifications();
            setInterval(loadUserNotifications, 30000);
        </script>
    }
</body>
</html>
