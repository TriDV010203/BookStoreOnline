<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel | BookStore</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style>
        :root {
            --admin-bg: #0f1117;
            --sidebar-bg: #16181f;
            --sidebar-width: 260px;
            --primary: #6366f1;
            --primary-light: #818cf8;
            --primary-glow: rgba(99,102,241,0.15);
            --success: #22c55e;
            --danger: #ef4444;
            --warning: #f59e0b;
            --card-bg: #1e2130;
            --card-border: rgba(255,255,255,0.06);
            --text-main: #e2e8f0;
            --text-muted: #94a3b8;
            --text-light: #64748b;
            --border: rgba(255,255,255,0.08);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--admin-bg);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
        }

        /* ===== SIDEBAR ===== */
        .admin-sidebar {
            width: var(--sidebar-width);
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0; left: 0; bottom: 0;
            z-index: 100;
            overflow-y: auto;
        }

        .sidebar-brand {
            padding: 1.5rem 1.25rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 0.75rem;
            text-decoration: none;
        }

        .sidebar-brand-icon {
            width: 38px; height: 38px;
            background: linear-gradient(135deg, var(--primary), var(--primary-light));
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.2rem;
            box-shadow: 0 0 20px var(--primary-glow);
        }

        .sidebar-brand-text {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-main);
            line-height: 1.2;
        }

        .sidebar-brand-sub {
            font-size: 0.7rem;
            color: var(--text-muted);
            font-weight: 400;
        }

        .sidebar-section {
            padding: 1rem 0.75rem 0.25rem;
        }

        .sidebar-section-label {
            font-size: 0.65rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text-light);
            padding: 0 0.5rem;
            margin-bottom: 0.5rem;
        }

        .sidebar-nav-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.65rem 0.75rem;
            border-radius: 10px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.875rem;
            font-weight: 500;
            transition: all 0.2s ease;
            margin-bottom: 0.15rem;
        }

        .sidebar-nav-item:hover {
            background: var(--primary-glow);
            color: var(--primary-light);
        }

        .sidebar-nav-item.active {
            background: var(--primary-glow);
            color: var(--primary-light);
            border-left: 3px solid var(--primary);
        }

        .sidebar-nav-item i {
            font-size: 1rem;
            width: 20px;
            text-align: center;
        }

        .sidebar-footer {
            margin-top: auto;
            padding: 1rem 0.75rem;
            border-top: 1px solid var(--border);
        }

        .sidebar-user {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.5rem;
            border-radius: 10px;
        }

        .sidebar-avatar {
            width: 36px; height: 36px;
            background: linear-gradient(135deg, var(--primary), var(--primary-light));
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-weight: 700;
            font-size: 0.85rem;
            color: white;
        }

        .sidebar-user-name { font-size: 0.85rem; font-weight: 600; color: var(--text-main); }
        .sidebar-user-role { font-size: 0.7rem; color: var(--primary-light); }

        /* ===== MAIN CONTENT ===== */
        .admin-main {
            margin-left: var(--sidebar-width);
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* ===== TOP BAR ===== */
        .admin-topbar {
            background: var(--sidebar-bg);
            border-bottom: 1px solid var(--border);
            padding: 1rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 50;
        }

        .topbar-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--text-main);
        }

        .topbar-actions { display: flex; align-items: center; gap: 0.75rem; }

        .btn-topbar {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-muted);
            padding: 0.45rem 0.9rem;
            border-radius: 8px;
            font-size: 0.8rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: flex; align-items: center; gap: 0.4rem;
        }

        .btn-topbar:hover {
            background: var(--primary-glow);
            border-color: var(--primary);
            color: var(--primary-light);
        }

        .btn-topbar.danger:hover {
            background: rgba(239,68,68,0.1);
            border-color: var(--danger);
            color: var(--danger);
        }

        /* ===== CONTENT AREA ===== */
        .admin-content {
            padding: 2rem;
            flex: 1;
        }

        /* ===== CARDS ===== */
        .admin-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 16px;
            padding: 1.5rem;
        }

        .admin-card-title {
            font-size: 1rem;
            font-weight: 600;
            color: var(--text-main);
            margin-bottom: 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        /* ===== STAT CARDS ===== */
        .stat-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 16px;
            padding: 1.5rem;
            position: relative;
            overflow: hidden;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 40px rgba(0,0,0,0.3);
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0; right: 0;
            width: 80px; height: 80px;
            border-radius: 0 16px 0 80px;
            opacity: 0.08;
        }

        .stat-card.primary::before { background: var(--primary); }
        .stat-card.success::before { background: var(--success); }
        .stat-card.warning::before { background: var(--warning); }

        .stat-label {
            font-size: 0.78rem;
            font-weight: 500;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.5rem;
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 700;
            line-height: 1;
            margin-bottom: 0.5rem;
        }

        .stat-card.primary .stat-value { color: var(--primary-light); }
        .stat-card.success .stat-value { color: var(--success); }
        .stat-card.warning .stat-value { color: var(--warning); }

        .stat-icon {
            font-size: 1.5rem;
            position: absolute;
            top: 1.25rem; right: 1.25rem;
            opacity: 0.3;
        }

        /* ===== TABLES ===== */
        .admin-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }

        .admin-table th {
            background: rgba(255,255,255,0.03);
            color: var(--text-muted);
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            padding: 0.75rem 1rem;
            border-bottom: 1px solid var(--border);
        }

        .admin-table td {
            padding: 0.9rem 1rem;
            border-bottom: 1px solid rgba(255,255,255,0.04);
            font-size: 0.875rem;
            color: var(--text-main);
            vertical-align: middle;
        }

        .admin-table tr:last-child td { border-bottom: none; }

        .admin-table tbody tr {
            transition: background 0.15s;
        }

        .admin-table tbody tr:hover {
            background: rgba(255,255,255,0.03);
        }

        /* ===== BADGES ===== */
        .badge-admin {
            padding: 0.25rem 0.65rem;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
        }

        .badge-primary { background: var(--primary-glow); color: var(--primary-light); border: 1px solid rgba(99,102,241,0.3); }
        .badge-success { background: rgba(34,197,94,0.1); color: var(--success); border: 1px solid rgba(34,197,94,0.3); }
        .badge-warning { background: rgba(245,158,11,0.1); color: var(--warning); border: 1px solid rgba(245,158,11,0.3); }

        /* ===== BUTTONS ===== */
        .btn-admin-primary {
            background: linear-gradient(135deg, var(--primary), var(--primary-light));
            color: white;
            border: none;
            padding: 0.6rem 1.25rem;
            border-radius: 10px;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex; align-items: center; gap: 0.4rem;
            transition: all 0.2s;
            box-shadow: 0 4px 15px var(--primary-glow);
        }

        .btn-admin-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(99,102,241,0.4);
            color: white;
        }

        .btn-admin-edit {
            background: rgba(245,158,11,0.1);
            color: var(--warning);
            border: 1px solid rgba(245,158,11,0.3);
            padding: 0.35rem 0.75rem;
            border-radius: 8px;
            font-size: 0.78rem;
            font-weight: 500;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex; align-items: center; gap: 0.3rem;
            transition: all 0.2s;
        }

        .btn-admin-edit:hover {
            background: rgba(245,158,11,0.2);
            color: var(--warning);
        }

        .btn-admin-delete {
            background: rgba(239,68,68,0.1);
            color: var(--danger);
            border: 1px solid rgba(239,68,68,0.3);
            padding: 0.35rem 0.75rem;
            border-radius: 8px;
            font-size: 0.78rem;
            font-weight: 500;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex; align-items: center; gap: 0.3rem;
            transition: all 0.2s;
        }

        .btn-admin-delete:hover { background: rgba(239,68,68,0.2); }

        .btn-admin-secondary {
            background: transparent;
            color: var(--text-muted);
            border: 1px solid var(--border);
            padding: 0.6rem 1.25rem;
            border-radius: 10px;
            font-size: 0.85rem;
            font-weight: 500;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex; align-items: center; gap: 0.4rem;
            transition: all 0.2s;
        }

        .btn-admin-secondary:hover {
            background: rgba(255,255,255,0.05);
            color: var(--text-main);
        }

        /* ===== FORM ===== */
        .admin-form-group { margin-bottom: 1.25rem; }

        .admin-label {
            display: block;
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .admin-input {
            width: 100%;
            background: rgba(255,255,255,0.04);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 0.7rem 1rem;
            font-size: 0.9rem;
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .admin-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--primary-glow);
            background: rgba(99,102,241,0.05);
        }

        .admin-input.is-invalid { border-color: var(--danger); }
        .admin-input::placeholder { color: var(--text-light); }

        select.admin-input option {
            background: var(--card-bg);
            color: var(--text-main);
        }

        textarea.admin-input { resize: vertical; min-height: 100px; }

        .admin-error { color: var(--danger); font-size: 0.78rem; margin-top: 0.35rem; }

        /* ===== TOAST ===== */
        .admin-toast-container {
            position: fixed;
            bottom: 2rem; right: 2rem;
            z-index: 9999;
        }

        .admin-toast {
            padding: 1rem 1.5rem;
            border-radius: 12px;
            font-size: 0.875rem;
            font-weight: 500;
            display: flex; align-items: center; gap: 0.75rem;
            min-width: 280px;
            animation: toastIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
            backdrop-filter: blur(10px);
        }

        .admin-toast.success {
            background: rgba(22,197,94,0.15);
            border: 1px solid rgba(34,197,94,0.3);
            color: #86efac;
        }

        .admin-toast.error {
            background: rgba(239,68,68,0.15);
            border: 1px solid rgba(239,68,68,0.3);
            color: #fca5a5;
        }

        @@keyframes toastIn {
            from { opacity: 0; transform: translateX(30px); }
            to { opacity: 1; transform: translateX(0); }
        }

        @@keyframes toastOut {
            from { opacity: 1; transform: translateX(0); }
            to { opacity: 0; transform: translateX(30px); }
        }

        /* ===== PAGE HEADER ===== */
        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.75rem;
        }

        .page-header-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-main);
        }

        .page-header-sub {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-top: 0.2rem;
        }

        /* ===== BOOK IMAGE ===== */
        .book-thumb {
            width: 40px; height: 55px;
            object-fit: cover;
            border-radius: 6px;
            border: 1px solid var(--border);
        }

        .book-thumb-placeholder {
            width: 40px; height: 55px;
            background: var(--primary-glow);
            border-radius: 6px;
            display: flex; align-items: center; justify-content: center;
            color: var(--primary);
            font-size: 1.2rem;
        }

        /* ===== DELETE MODAL ===== */
        .admin-modal-overlay {
            position: fixed; inset: 0;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(4px);
            z-index: 1000;
            display: none;
            align-items: center; justify-content: center;
        }

        .admin-modal-overlay.show { display: flex; }

        .admin-modal {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 2rem;
            max-width: 400px;
            width: 90%;
            text-align: center;
            animation: modalIn 0.25s ease;
        }

        @@keyframes modalIn {
            from { opacity: 0; transform: scale(0.9); }
            to { opacity: 1; transform: scale(1); }
        }

        .modal-icon {
            width: 64px; height: 64px;
            background: rgba(239,68,68,0.1);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 1rem;
            font-size: 1.75rem;
            color: var(--danger);
        }

        .modal-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem; }
        .modal-text { font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1.5rem; }

        /* ===== RESPONSIVE ===== */
        @@media (max-width: 768px) {
            .admin-sidebar { transform: translateX(-100%); transition: transform 0.3s; }
            .admin-sidebar.open { transform: translateX(0); }
            .admin-main { margin-left: 0; }
            .admin-content { padding: 1rem; }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- ===== SIDEBAR ===== -->
    <aside class="admin-sidebar">
        <a asp-controller="Admin" asp-action="Index" class="sidebar-brand">
            <div class="sidebar-brand-icon">📚</div>
            <div>
                <div class="sidebar-brand-text">BookStore</div>
                <div class="sidebar-brand-sub">Admin Panel</div>
            </div>
        </a>

        <div class="sidebar-section">
            <div class="sidebar-section-label">Tổng quan</div>
            <a asp-controller="Admin" asp-action="Index"
               class="sidebar-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                <i class="bi bi-grid-1x2"></i>
                Dashboard
            </a>
        </div>

        <div class="sidebar-section">
            <div class="sidebar-section-label">Quản lý nội dung</div>
            <a asp-controller="Admin" asp-action="Books"
               class="sidebar-nav-item @(new[]{"Books","BookCreate","BookEdit"}.Contains(ViewContext.RouteData.Values["action"]?.ToString()) ? "active" : "")">
                <i class="bi bi-book"></i>
                Sách
            </a>
            <a asp-controller="Admin" asp-action="Categories"
               class="sidebar-nav-item @(new[]{"Categories","CategoryCreate","CategoryEdit"}.Contains(ViewContext.RouteData.Values["action"]?.ToString()) ? "active" : "")">
                <i class="bi bi-tag"></i>
                Danh mục
            </a>
            <a asp-controller="Admin" asp-action="Orders"
               class="sidebar-nav-item @(new[]{"Orders","OrderDetail"}.Contains(ViewContext.RouteData.Values["action"]?.ToString()) ? "active" : "")">
                <i class="bi bi-receipt"></i>
                Đơn hàng
            </a>
            <a asp-controller="Admin" asp-action="Discounts"
               class="sidebar-nav-item @(new[]{"Discounts","DiscountCreate","DiscountEdit"}.Contains(ViewContext.RouteData.Values["action"]?.ToString()) ? "active" : "")">
                <i class="bi bi-tag-fill"></i>
                Giảm giá
            </a>
        </div>

        <div class="sidebar-section">
            <div class="sidebar-section-label">Người dùng</div>
            <a asp-controller="Admin" asp-action="Users"
               class="sidebar-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")">
                <i class="bi bi-people"></i>
                Quản lý Users
            </a>
        </div>

        <div class="sidebar-section">
            <div class="sidebar-section-label">Hệ thống</div>
            <a asp-controller="Home" asp-action="Index" class="sidebar-nav-item">
                <i class="bi bi-shop"></i>
                Xem cửa hàng
            </a>
        </div>


        <div class="sidebar-footer">
            <div class="sidebar-user">
                <div class="sidebar-avatar">
                    @(Context.Session.GetString("UserFullName")?[0].ToString().ToUpper() ?? "A")
                </div>
                <div>
                    <div class="sidebar-user-name">@Context.Session.GetString("UserFullName")</div>
                    <div class="sidebar-user-role">Administrator</div>
                </div>
            </div>
            <a asp-controller="Account" asp-action="Logout" class="btn-topbar danger mt-2 w-100" style="justify-content: center;">
                <i class="bi bi-box-arrow-right"></i> Đăng xuất
            </a>
        </div>
    </aside>

    <!-- ===== MAIN ===== -->
    <div class="admin-main">
        <!-- Top Bar -->
        <header class="admin-topbar">
            <span class="topbar-title">@ViewData["Title"]</span>
            <div class="topbar-actions">
                <!-- Admin Bell Notification -->
                <div class="admin-bell-wrap" style="position:relative">
                    <button id="adminBellBtn" class="btn-topbar" onclick="toggleOrderPanel()" title="Đơn hàng mới" style="position:relative">
                        <i class="bi bi-bell-fill"></i>
                        <span id="adminBellBadge" style="display:none;position:absolute;top:-4px;right:-4px;background:#ef4444;color:#fff;font-size:.65rem;font-weight:700;border-radius:50%;width:18px;height:18px;line-height:18px;text-align:center">0</span>
                    </button>
                    <div id="adminOrderPanel" style="display:none;position:absolute;top:calc(100% + 10px);right:0;width:300px;background:#1e2130;border:1px solid rgba(255,255,255,.1);border-radius:14px;box-shadow:0 20px 60px rgba(0,0,0,.5);z-index:999;overflow:hidden">
                        <div style="padding:.85rem 1.1rem;border-bottom:1px solid rgba(255,255,255,.07);font-weight:600;font-size:.85rem;color:#e2e8f0;display:flex;align-items:center;justify-content:space-between">
                            <span>📦 Đơn hàng chờ xử lý</span>
                            <a asp-action="Orders" asp-route-status="Pending" style="font-size:.75rem;color:#818cf8;text-decoration:none">Xem tất cả</a>
                        </div>
                        <div id="adminOrderList" style="max-height:220px;overflow-y:auto;padding:.5rem"></div>
                    </div>
                </div>
                <a asp-controller="Home" asp-action="Index" class="btn-topbar">
                    <i class="bi bi-shop"></i> Cửa hàng
                </a>
            </div>
        </header>

        <!-- Toast Notifications -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="admin-toast-container" id="adminToast">
                <div class="admin-toast success">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>@TempData["SuccessMessage"]</span>
                    <button onclick="dismissAdminToast()" style="background:none;border:none;color:inherit;cursor:pointer;margin-left:auto;">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="admin-toast-container" id="adminToast">
                <div class="admin-toast error">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>@TempData["ErrorMessage"]</span>
                    <button onclick="dismissAdminToast()" style="background:none;border:none;color:inherit;cursor:pointer;margin-left:auto;">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
        }

        <!-- Content -->
        <main class="admin-content">
            @RenderBody()
        </main>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function dismissAdminToast() {
            var t = document.getElementById('adminToast');
            if (t) { t.style.animation = 'toastOut 0.3s ease forwards'; setTimeout(() => t.remove(), 350); }
        }
        setTimeout(dismissAdminToast, 3000);

        // Delete confirm modal
        function confirmDelete(formId, itemName) {
            document.getElementById('deleteItemName').textContent = itemName;
            document.getElementById('deleteFormId').value = formId;
            document.getElementById('deleteModal').classList.add('show');
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.remove('show');
        }

        function executeDelete() {
            var formId = document.getElementById('deleteFormId').value;
            document.getElementById(formId).submit();
        }
    </script>

    <!-- Global Delete Confirm Modal -->
    <div class="admin-modal-overlay" id="deleteModal" onclick="closeDeleteModal()">
        <div class="admin-modal" onclick="event.stopPropagation()">
            <div class="modal-icon"><i class="bi bi-trash3"></i></div>
            <div class="modal-title">Xác nhận xóa</div>
            <p class="modal-text">Bạn có chắc chắn muốn xóa "<strong id="deleteItemName"></strong>" không? Hành động này không thể hoàn tác.</p>
            <input type="hidden" id="deleteFormId" />
            <div class="d-flex gap-2 justify-content-center">
                <button class="btn-admin-secondary" onclick="closeDeleteModal()">
                    <i class="bi bi-x-lg"></i> Hủy
                </button>
                <button class="btn-admin-delete" onclick="executeDelete()" style="padding: 0.6rem 1.5rem;">
                    <i class="bi bi-trash3"></i> Xóa
                </button>
            </div>
        </div>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
    <!-- SignalR CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        // ===== ADMIN REALTIME ORDER NOTIFICATION =====
        var adminConnection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/orders")
            .withAutomaticReconnect()
            .build();

        var adminPendingCount = 0;
        var adminOrderPanel = false;

        adminConnection.on("NewOrderAlert", function(data) {
            adminPendingCount++;
            updateAdminBell(adminPendingCount);
            showAdminOrderToast(data);
            loadPendingOrderList();
        });

        adminConnection.start().then(function() {
            adminConnection.invoke("JoinAdminGroup");
            loadPendingOrderCount();
        }).catch(function(err) { console.warn("SignalR admin error:", err); });

        function loadPendingOrderCount() {
            fetch('/Admin/GetPendingOrderCount')
                .then(r => r.json())
                .then(d => { adminPendingCount = d.count; updateAdminBell(adminPendingCount); })
                .catch(() => {});
        }

        function updateAdminBell(count) {
            var badge = document.getElementById('adminBellBadge');
            if (count > 0) {
                badge.textContent = count > 9 ? '9+' : count;
                badge.style.display = 'block';
                document.getElementById('adminBellBtn').style.color = '#f59e0b';
            } else {
                badge.style.display = 'none';
                document.getElementById('adminBellBtn').style.color = '';
            }
        }

        function toggleOrderPanel() {
            var panel = document.getElementById('adminOrderPanel');
            adminOrderPanel = !adminOrderPanel;
            panel.style.display = adminOrderPanel ? 'block' : 'none';
            if (adminOrderPanel) loadPendingOrderList();
        }

        function loadPendingOrderList() {
            var list = document.getElementById('adminOrderList');
            fetch('/Admin/Orders?status=Pending')
                .catch(() => {});
            list.innerHTML = '<div style="padding:1rem;text-align:center;color:#94a3b8;font-size:.82rem">&#128279; <a href="/Admin/Orders?status=Pending" style="color:#818cf8">Xem danh sách đơn Pending</a></div>';
        }

        function showAdminOrderToast(data) {
            var container = document.createElement('div');
            container.className = 'admin-toast-container';
            container.style.cssText = 'position:fixed;bottom:2rem;right:2rem;z-index:9999';
            container.innerHTML = '<div class="admin-toast success" style="min-width:320px">' +
                '<i class="bi bi-bag-check-fill" style="color:#f59e0b"></i>' +
                '<div><div style="font-weight:600;font-size:.9rem">Đơn hàng mới!</div>' +
                '<div style="font-size:.8rem;opacity:.8">' + (data.message || 'Đƣn hàng mới cần xử lý') + '</div></div>' +
                '<button onclick="this.parentElement.parentElement.remove()" style="background:none;border:none;color:inherit;cursor:pointer;margin-left:auto"><i class="bi bi-x-lg"></i></button>' +
                '</div>';
            document.body.appendChild(container);
            setTimeout(() => container.remove(), 6000);
        }

        // Close panel when clicking outside
        document.addEventListener('click', function(e) {
            if (adminOrderPanel && !e.target.closest('.admin-bell-wrap')) {
                document.getElementById('adminOrderPanel').style.display = 'none';
                adminOrderPanel = false;
            }
        });
    </script>
</body>
</html>
